# Modèle de configuration pour JIBI 2 — copier en « .env » puis ajuster.
# .env est dans .gitignore : il ne part jamais dans le dépôt.
# Le cerveau (Ollama) et l'interface marchent sans aucune clé : chaque
# champ ci-dessous est optionnel et reste sur ton PC.

# ---- Cerveau (Ollama local) ---------------------------------------------
JIBI_LLM_MODEL=qwen3.5:4b          # 2b si moins de 16 Go de RAM
JIBI_LLM_URL=http://127.0.0.1:11434
JIBI_LLM_THINK=0                   # essentiel sur CPU : think désactivé
JIBI_LLM_MAX=                      # plafond de génération (JIBI_LLM_MAX)
JIBI_LLM_CTX=                      # fenêtre de contexte
JIBI_FLUX=1                        # réponse affichée mot à mot (streaming)
JIBI_HISTOIRE=12                   # tours de conversation gardés
JIBI_NOM=JIBI

# ---- Voix / micro ---------------------------------------------------------
PIPER_MODELE=                      # vide = première voix .onnx de modeles/voix/
WHISPER_MODELE=small               # medium = lent sans GPU
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
JIBI_VOIX_ACTIVE=0
JIBI_MOT_ACTIVATION=jibi
JIBI_FENETRE_SUIVI=60              # secondes en « mains libres » après une réponse

# ---- Sécurité -------------------------------------------------------------
CONFIRMER_RISQUES=1                # confirmation humaine des actions à risque
CONFIRMER_DEPLACEMENT=1            # confirmation des déplacements de fichiers
JIBI_AUTONOMIE_NOYAU=0             # 0 : toute écriture noyau exige un humain
JIBI_MODIFICATION_AUTO=0           # modifs transactionnelles du noyau

# Permissions N1/N2/N3 (faible/moyen/élevé) : toujours | demander | jamais.
# N1/N2 sans demande par défaut, N3 demande par défaut. Les outils dits _N3
# (eteindre_pc, executer_commande, modifier_noyau, restaurer_noyau,
# installer_mise_a_jour) ignorent « toujours » : ils demandent, toujours,
# même avec CONFIRMER_RISQUES=0 — c'est le code qui refuse, pas un réglage.
JIBI_AUTORISATION_N1=              # vide = défaut du niveau
JIBI_AUTORISATION_N2=
JIBI_AUTORISATION_N3=

# ---- Panneau web local ----------------------------------------------------
JIBI_PANNEAU_PORT=8756

# ---- Serveur MCP (désactivé par défaut) ------------------------------------
JIBI_MCP=0                         # 1 = exposer les lectures sûres
JIBI_MCP_PORT=8080

# ---- Autonomie / exploration ----------------------------------------------
JIBI_AUTONOMIE_ACTIVE=0
JIBI_AUTONOMIE_HEURE=04:00
JIBI_EXPLORATION_ACTIVE=0
JIBI_SIGNAL_ACTIF=0
JIBI_SIGNAL_HEURE=08:00

# ---- Navigation locale / divers --------------------------------------------
JIBI_BROWSER_USE=0
JIBI_BROWSER_HEADLESS=0
JIBI_BROWSER_VISION=0
JIBI_CHROME_SEARCH_BACKGROUND=1
JIBI_GEOLOCATION=1

# ---- Clés optionnelles (jamais obligatoires, jamais commitées) -------------
# TAVILY_API_KEY=                  # recherche web ; sinon repli local
# OPENROUTER_API_KEY=              # cerveau cloud optionnel (OpenRouter)
# ANTHROPIC_API_KEY=               # cerveau cloud optionnel (Anthropic)
#
# CERVEAU CLOUD : FERMÉ PAR DÉFAUT. Même avec une clé ci-dessus, AUCUNE
# donnée ne part vers un serveur tant que tu n'écris pas toi-même
# JIBI_CLOUD=1. Règle n° 1 : JIBI reste 100 % local.
# JIBI_CLOUD=0                     # 0 = 100 % local (recommandé) · 1 = active le cloud
# JIBI_CLOUD_MARQUE=               # openrouter | anthropic
# JIBI_CLOUD_AUTO=0                # 1 = demandes complexes → cloud direct
# JIBI_CLOUD_MODEL_ANTHROPIC=      # vide = claude-sonnet-4-20250514
