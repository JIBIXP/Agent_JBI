# ══════════════════════════════════════════════════════════════════
#  JIBI 2 — configuration. Tout reste sur ton PC.
#  Modifie une valeur puis relance JIBI. (python docteur.py vérifie tout.)
# ══════════════════════════════════════════════════════════════════

# ── Cerveau (Ollama) — TON PC N'A PAS DE GPU : tout tourne sur le CPU ──
#   ≥ 16 Go de RAM → qwen3.5:4b (parfait)   ·   moins → qwen3.5:2b
#   (python docteur.py --modele te dit quoi prendre)
JIBI_LLM_MODEL=qwen3.5:4b
JIBI_LLM_URL=http://127.0.0.1:11434
# 0 = réponses rapides (le modèle ne « réfléchit » pas en texte). Laisse à 0.
JIBI_LLM_THINK=0
# VITESSE CPU : plafond de tokens générés par réponse (600 = assez pour un
# PDF entier ; descends à 150 si tu ne crées jamais de longs documents).
JIBI_LLM_MAX=600
# VITESSE CPU : fenêtre de contexte (petite = pré-remplissage plus rapide).
JIBI_LLM_CTX=4096
# VITESSE : combien de temps Ollama garde le modèle en mémoire.
# -1 = toujours chargé (réponses quasi instantanées après le 1er message)
JIBI_KEEP_ALIVE=-1
# Historique gardé en mémoire (paires échange+réponse). 6 = rapide sur CPU
# (chaque message relu coûte du pré-remplissage) ; monte à 12 si tu veux
# des conversations plus longues au prix de la vitesse.
JIBI_HISTOIRE=6
JIBI_NOM=JIBI

# ── Voix sortante (JIBI parle) ─────────────────────────────────────
# piper = voix française locale (modeles/voix). pyttsx3 = secours Windows. aucun = muet.
TTS_ENGINE=piper
# Laisse vide = 1re voix du dossier. « voix tom » à JIBI = voix masculine auto (outil changer_voix)
PIPER_MODELE=

# ── Voix entrante (micro → texte) ──────────────────────────────────
# faster_whisper = local. google = en ligne (repli). aucun = pas de micro.
# CPU oblige : small + int8 = rapide ; évite medium (très lent sans GPU).
STT_ENGINE=faster_whisper
WHISPER_MODELE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# ── Mains-libres ───────────────────────────────────────────────────
JIBI_VOIX_ACTIVE=0
JIBI_MOT_ACTIVATION=jibi
# Après une réponse, tu peux enchaîner sans redire « jibi » pendant (secondes) :
JIBI_FENETRE_SUIVI=60

# ── Confort ────────────────────────────────────────────────────────
# 1 = la réponse s'affiche mot à mot pendant qu'elle se génère
JIBI_FLUX=1
# 1 = les workflows avec horaire (HH:MM) s'exécutent automatiquement
JIBI_HORAIRE_ACTIF=1

# ── Vision d'écran (CPU) ───────────────────────────────────────────
# moondream (~1,4 Go) = le modèle de vision léger, conçu pour le CPU.
# Installe-le une fois :  ollama pull moondream   (et pip install pillow)
JIBI_VISION_MODEL=moondream

# ── Sécurité ───────────────────────────────────────────────────────
# 1 = JIBI demande confirmation avant les actions à risque élevé
# (executer_commande, eteindre_pc). Ne mets 0 que si tu es sûr de toi.
CONFIRMER_RISQUES=1


# Jeu d'outils montré au modèle : "noyau" = jeu réduit adapté à la demande
# (plus rapide et plus fiable, leçon Jarvis) — "tous" = les 47 d'un coup.
JIBI_OUTILS=noyau

# Assistance Chrome : port de débogage du profil dédié « ChromeJIBI »
# (lance CHROME_JIBI.bat, ou JIBI le démarre tout seul si Chrome est trouvé)
JIBI_CDP_PORT=9222
# Lumière vidéo amaran via pont ESP32 (wesbos/amaran-BLE-control). Vide = désactivé.
# JIBI_AMARAN_URL=http://192.168.1.50:2708

# Panneau web local (page de discussion, 127.0.0.1 uniquement)
JIBI_PANNEAU_PORT=8756

# Mise à jour : URL d'un fichier texte donnant la dernière version (ex. hébergé
# sur ton GitHub). Vide = JIBI rappelle simplement la procédure de mise à jour.
# JIBI_VERSION_URL=https://exemple.fr/jibi_version.txt
